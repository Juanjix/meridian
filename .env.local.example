# App
NEXT_PUBLIC_URL=http://localhost:3000

# Mercado Pago
MP_ACCESS_TOKEN=your_mp_access_token_here
MP_PUBLIC_KEY=your_mp_public_key_here

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email (Nodemailer — required for reservation notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hola@meridianground.com
SMTP_PASS=your_app_password
SMTP_FROM="Executive Arrival <hola@meridianground.com>"
RESERVATION_EMAIL_TO=vitalmariano7@gmail.com

# Database (Supabase recommended for simplicity) — required.
# Reservations are persisted here BEFORE any notification email is sent,
# so a lead is never lost if the email provider is unavailable.
# After setting this, run: npx prisma migrate dev --name init
DATABASE_URL=postgresql://user:pass@host:5432/meridian
